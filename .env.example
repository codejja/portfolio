# Kopioi tämä tiedosto nimelle .env.local ja täytä oma Anthropic API -avaimesi.
# .env.local on gitignoroitu, joten avain ei koskaan päädy versionhallintaan.

# Pakollinen: data-analyysiagentin demo (app/lab/data-analyst-agent) ei toimi ilman tätä.
# Hae avain osoitteesta https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Valinnainen: mallin voi vaihtaa, oletus on kustannustehokas Claude Haiku 4.5.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
